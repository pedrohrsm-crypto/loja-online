# Toda variável lida no código precisa estar aqui (guarda em lib/guardas.test.ts).
# Os valores reais moram na hospedagem, na conta do CLIENTE (docs/freelance/PASSAGEM.md §2).

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Só no servidor. Nunca com prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Endereço público do site, para as URLs de volta do pagamento
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe (modo teste até o roteiro de virada: docs/runbooks/pagamento-producao.md)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Versão da API fixada (04, erro 3.2). Subir de versão é decisão, com teste.
STRIPE_API_VERSION=
# Um id de preço por produto de lib/pagamentos/produtos.ts
STRIPE_PRECO_CURSO=
# Meios de pagamento do checkout, separados por vírgula (card, pix, boleto…).
# Conferir na documentação do Stripe o que a conta do cliente aceita ANTES de prometer.
PAGAMENTO_METODOS=card

# Mercado Pago, Orders API (Checkout Transparente, D-LO-5). Os nomes são os da Vercel (Production e
# Preview, conferidos pelo PM em 4-Nov). O modo NÃO se deduz da credencial (teste e produção começam
# com APP_USR): PAGAMENTO_MODO é explícito, `teste` ou `producao`, e a loja não cobra sem ele.
PAGAMENTO_MODO=teste
# Só no servidor (sensitive na Vercel).
MERCADOPAGO_ACCESS_TOKEN=
# Assinatura secreta do webhook (painel do Mercado Pago → Webhooks). Só no servidor.
MERCADOPAGO_WEBHOOK_SECRET=
# Chave pública, para o Card Payment Brick no navegador (F4b). A única com NEXT_PUBLIC_.
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=

# Protege /api/cron/reconciliar (a Vercel e o GitHub Actions enviam no cabeçalho Authorization) (a Vercel envia no cabeçalho Authorization)
CRON_SECRET=
